{
  "name": "@life-tracker/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "test:unit": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed:staging": "tsx src/db/seed-staging-cli.ts",
    "dev": "wrangler dev",
    "build:worker": "wrangler deploy --dry-run --outdir ../.stage/worker",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:coverage:int": "vitest run --config vitest.int.config.ts --coverage --passWithNoTests"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.3",
    "testcontainers": "^12.2.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@life-tracker/shared": "workspace:*",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "pg": "^8.23.1"
  }
}
