// One Worker serves the built web app and the API (ADR-0021, MIG-03).
// Secrets (DATABASE_URL) are never written here: locally they go in api/.dev.vars, in production in Cloudflare secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-tracker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Needed by the `pg` driver (sockets, crypto) and so that secrets appear in process.env.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // Run the Worker for every request so security headers reach static files too (AC-MIG-03.7).
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Maintenance documents (MIL-07, ADR-0024): a private R2 bucket. It has no public access; the Worker is the only way in.
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "life-tracker-documents" }],
  // Workers Logs (MIG-06): keeps the JSON lines written by telemetry/logger.ts, searchable in the dashboard.
  // Free plan: 200,000 events a day, 3 days of history. One user stays far below that, so every request is kept.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Staging (OPS-08, ADR-0025): the same code on its own Worker, its own Neon project and its own R2 bucket, with synthetic data only.
  // Deploy it with `wrangler deploy --env staging`; without --env, wrangler deploys production. A Wrangler environment does not
  // inherit bindings, so the bucket (and everything else a binding would otherwise take from production) is written out again.
  // Secrets (DATABASE_URL, ACCESS_TEAM_DOMAIN, ACCESS_AUD, OWNER_EMAIL) are set on this Worker in Cloudflare, never here.
  "env": {
    "staging": {
      "name": "life-tracker-staging",
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "single-page-application"
      },
      "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "life-tracker-documents-staging" }],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
