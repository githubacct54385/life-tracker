{
  "name": "life-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && depcruise shared/src api/src web/src --config .dependency-cruiser.js",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "pnpm -r test:unit && vitest run --root scripts",
    "test:int": "pnpm -r test:int",
    "test:e2e": "pnpm --filter web test:e2e",
    "test": "pnpm test:unit && pnpm test:int && pnpm test:e2e",
    "build": "pnpm -r build",
    "migrate": "pnpm --filter @life-tracker/api migrate",
    "seed:staging": "pnpm --filter @life-tracker/api seed:staging",
    "pr-screenshots": "node scripts/pr-screenshots.mjs",
    "dev": "pnpm --filter web build && pnpm --filter @life-tracker/api dev",
    "dev:web": "pnpm --filter web dev",
    "tests:list": "node scripts/tests-list.mjs",
    "check:worker-size": "node scripts/check-worker-size.mjs",
    "coverage:unit": "pnpm --filter shared test:coverage && pnpm --filter api test:coverage && pnpm --filter web test:coverage",
    "coverage:int": "pnpm --filter api test:coverage:int",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "chrome-launcher": "^1.2.3",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
